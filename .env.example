# Live AI mode. Without this the app runs in clearly-labelled demo mode (rule-based engine).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for analysis, conversation and package generation.
# BLANKETT_MODEL=claude-opus-5

# Optional: force demo mode even when a key is present (useful for offline demos).
# BLANKETT_FORCE_DEMO=1

# Optional: natural voice for the client call (ElevenLabs text-to-speech + Scribe speech-to-text).
# Without it the browser's Web Speech API is used.
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=            # optional; defaults to a premade voice on the account
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional: reasoning effort for the document analysis. "low" (~60-70s on the sample case) is the
# default; "medium" (~100s) digs a little deeper.
# BLANKETT_ANALYSIS_EFFORT=low

# Optional: run conversation turns (browser and phone) on a faster model without extended thinking.
# Phone turns are latency-critical; the analysis still uses BLANKETT_MODEL.
# BLANKETT_CONVERSE_MODEL=claude-sonnet-5
# BLANKETT_CONVERSE_THINKING=off

# Optional: Twilio <Say> voice for phone calls when ElevenLabs is not configured.
# TWILIO_VOICE=Google.en-US-Chirp3-HD-Aoede
